        "type": "object",
        "properties": {"notes": {"type": "string"}, "query": {"type": "string"}}
      }
    },
    {
      "name": "delete_record",
      "description": "Delete a record by id.",
      "inputSchema": {
        "type": "object",
        "properties": {"id": {"type": "string", "pattern": "^[0-9]+$"}},
        "required": ["id", "reason"],
        "additionalProperties": false
      }
    },
    {
      "name": "sync_crm",
      "description": "Sync contacts.​",
      "inputSchema": {
        "type": "object",
        "properties": {"mode": {"type": "string", "enum": ["full", "delta"]}},
        "additionalProperties": false
      }
    }
  ]
